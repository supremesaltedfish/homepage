.section-heading h2 { margin:.2rem 0; }
.room-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:1rem; }
.room-card { grid-column:span 2; min-height:260px; display:flex; flex-direction:column; align-items:flex-start; padding:1.6rem 1.5rem; background:linear-gradient(150deg, rgba(16,43,69,.34), rgba(2,17,31,.18)); border-top:1px solid rgba(251,201,130,.25); border-bottom:1px solid rgba(181,201,209,.09); }
.room-card:nth-child(4), .room-card:nth-child(5) { grid-column:span 3; min-height:220px; }
.room-card:hover { border-top-color:var(--gold); background:linear-gradient(150deg, rgba(16,43,69,.55), rgba(2,17,31,.3)); }
.card-symbol { color:var(--gold); font-size:1.3rem; margin-bottom:.55rem; }
.card-label { font-size:.59rem; letter-spacing:.16em; }
.room-card p { font-size:.95rem; line-height:1.75; margin:.2rem 0 1rem; }
.card-link { margin-top:auto; color:var(--gold-dim); font-family:var(--sans); text-transform:uppercase; letter-spacing:.13em; font-size:.62rem; }
.note-panel { display:grid; grid-template-columns:70px 1fr; gap:1.5rem; margin:5rem 0 2rem; padding:2rem 0; border-top:1px solid var(--soft-line); border-bottom:1px solid var(--soft-line); }
.note-mark { color:var(--gold); font-family:var(--display); font-size:3.5rem; text-align:center; line-height:1; }
.note-panel h2 { font-size:2rem; }
.site-footer { text-align:center; padding:3rem 1rem 2.5rem; color:rgba(181,201,209,.64); font-size:.9rem; }
.site-footer p { margin:.25rem 0; }
.site-footer span { color:var(--gold); }
.footer-small, .small-note { font-size:.82rem; color:rgba(181,201,209,.58); }
.mini-hero { width:min(calc(100% - 2.5rem), var(--measure)); margin:0 auto; padding:1.5rem 0 0; text-align:center; }
.mini-wordmark { display:inline-block; font-family:var(--display); color:var(--frost); text-transform:uppercase; letter-spacing:.2em; font-size:2.3rem; }
.mini-wordmark span { color:var(--gold); font-size:1rem; vertical-align:middle; }
.mini-hero .main-nav { margin-top:.8rem; }
.inner-page { min-height:60vh; padding-top:3.4rem; }
.inner-page > .section-kicker, .inner-page > h1 { text-align:center; }
.inner-page > .ornament { margin-bottom:2.4rem; }
.narrow { max-width:760px; margin:0 auto 2.7rem; text-align:center; }
.prose-panel { max-width:790px; margin:0 auto; padding:clamp(1.4rem,4vw,3rem); background:linear-gradient(145deg, rgba(16,43,69,.3), rgba(2,17,31,.12)); border-top:1px solid var(--line); }
.prose-panel h2 { margin-top:2.4rem; font-size:2rem; }
.star-list { padding-left:1.3rem; }
.star-list li { padding:.3rem 0 .3rem .25rem; }
.star-list li::marker { content:"✧  "; color:var(--gold); }
.fandom-entry { display:grid; grid-template-columns:75px 1fr; gap:1.5rem; padding:2rem 0; border-top:1px solid var(--soft-line); }
.entry-number { color:var(--gold); font-family:var(--display); font-size:2.8rem; line-height:1; padding-top:.2rem; }
.fandom-entry h2 { margin:.1rem 0 .8rem; }
.tag-row { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1.1rem; }
.tag-row span { border:1px solid rgba(251,201,130,.22); padding:.2rem .6rem; font-family:var(--sans); font-size:.62rem; letter-spacing:.07em; color:var(--gold-dim); }
.callout { display:grid; grid-template-columns:38px 1fr; gap:1rem; margin:2rem 0; padding:1.2rem 1.4rem; border-left:1px solid var(--gold); background:rgba(16,43,69,.22); }
.callout-symbol { color:var(--gold); font-size:1.5rem; }
.callout p { margin:0; }
.work-card { padding:1.8rem 0; border-top:1px solid var(--soft-line); }
.work-card h2 { margin:.2rem 0; }
.work-meta { color:rgba(181,201,209,.65); letter-spacing:.12em; }
.work-note { padding:.9rem 1rem; border-left:1px solid var(--gold); background:rgba(16,43,69,.2); font-size:.94rem; }
.work-note span { color:var(--gold); }
.recommendation-list { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
.recommendation-list article { padding:1.5rem; border-top:1px solid var(--line); background:rgba(16,43,69,.2); }
.rec-type { font-size:.58rem; }
.recommendation-list h2 { font-size:1.8rem; }
.recommendation-list p { font-size:.94rem; }
.rec-link { margin-top:1.2rem; font-family:var(--sans); text-transform:uppercase; font-size:.65rem !important; letter-spacing:.1em; }
.social-list { max-width:800px; margin:0 auto; border-top:1px solid var(--soft-line); }
.social-row { display:grid; grid-template-columns:48px 1fr 25px; gap:1rem; align-items:center; padding:1.15rem .5rem; border-bottom:1px solid var(--soft-line); }
.social-icon { width:40px; height:40px; display:grid; place-items:center; border:1px solid rgba(251,201,130,.25); color:var(--gold); font-family:var(--display); font-size:1.25rem; }
.social-row strong { display:block; font-family:var(--display); font-size:1.45rem; font-weight:400; color:var(--frost); }
.social-row small { display:block; color:rgba(181,201,209,.75); font-size:.9rem; }
.external { color:var(--gold-dim); }
.small-note { max-width:800px; margin:1.5rem auto; }
code { color:var(--gold); background:rgba(16,43,69,.35); padding:.1rem .3rem; }
.back-link { margin:3rem 0 0; text-align:center; font-family:var(--sans); text-transform:uppercase; letter-spacing:.12em; font-size:.68rem; }
@media (max-width:720px) {
  body { font-size:16px; }
  .hero { min-height:490px; padding-top:5rem; }
  .hero-art { height:430px; }
  .hero-art::before { width:75vw; top:14%; }
  .hero-art::after { letter-spacing:.8rem; }
  .main-nav { gap:.3rem .95rem; }
  .main-nav a { font-size:.59rem; letter-spacing:.16em; }
  .room-card, .room-card:nth-child(4), .room-card:nth-child(5) { grid-column:span 3; }
  .room-card { min-height:230px; padding:1.25rem; }
  .recommendation-list { grid-template-columns:1fr; }
}
@media (max-width:480px) {
  .site-shell { width:min(calc(100% - 1.5rem), var(--measure)); }
  .hero { min-height:455px; padding-inline:.8rem; }
  .hero-subtitle { max-width:300px; margin-inline:auto; }
  .room-grid { display:block; }
  .room-card, .room-card:nth-child(4), .room-card:nth-child(5) { min-height:0; margin-bottom:.8rem; }
  .note-panel { grid-template-columns:40px 1fr; gap:.8rem; }
  .note-mark { font-size:2.4rem; }
  .fandom-entry { grid-template-columns:42px 1fr; gap:.7rem; }
  .entry-number { font-size:2rem; }
  .mini-hero { width:calc(100% - 1.5rem); }
  .social-row { grid-template-columns:38px 1fr 18px; gap:.7rem; }
  .social-icon { width:34px; height:34px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior:auto; } *, *::before, *::after { transition:none !important; } }
