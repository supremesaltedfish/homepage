@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=IM+Fell+English:ital@0;1&display=swap');

:root {
  --night: #010B15;
  --deep: #02111F;
  --blue: #102B45;
  --blue-glass: rgba(16, 43, 69, .28);
  --mist: #B5C9D1;
  --mist-bright: #cfe0e6;
  --frost: #F4F7F8;
  --gold: #FBC982;
